# Optional overrides for scripts/local-indexer/start.sh
# Copy to scripts/local-indexer/.env if you want (that file is gitignored).
# Do not put wallet seeds or Blockfrost tokens in this file.

INDEXER_IMAGE=midnightntwrk/indexer-standalone:4.4.101
INDEXER_NAME=midnight-indexer-preprod
NETWORK_ID=preprod

# Public Preprod RPC. Docs say this endpoint was retired on 9 October 2026
# and should not be relied on; it still answered at the time of the trial.
NODE_WS=wss://rpc.preprod.midnight.network
NODE_HTTP=https://rpc.preprod.midnight.network

# Host bind. Keep this on localhost.
INDEXER_BIND=127.0.0.1
INDEXER_PORT=8088

# Default: <this-dir>/data (gitignored)
# DATA_DIR=/var/lib/night-messenger/indexer-preprod

# After /ready returns 200, point the deploy script at:
#   MIDNIGHT_INDEXER_URL=http://127.0.0.1:8088/api/v4/graphql
#   MIDNIGHT_INDEXER_WS_URL=ws://127.0.0.1:8088/api/v4/graphql/ws
#   MIDNIGHT_NODE=https://rpc.preprod.midnight.network
#   MIDNIGHT_NODE_WS=wss://rpc.preprod.midnight.network
