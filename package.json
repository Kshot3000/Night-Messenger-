{
  "name": "night-messenger",
  "private": true,
  "version": "0.1.0",
  "description": "Night Messenger — free private DMs on Midnight with selective disclosure",
  "scripts": {
    "dev": "pnpm --filter @midnight-messenger/web dev",
    "dev:web": "pnpm --filter @midnight-messenger/web dev",
    "dev:mobile": "pnpm --filter @midnight-messenger/mobile start",
    "build": "pnpm -r --filter=./packages/* build && pnpm --filter @midnight-messenger/web build",
    "build:web": "pnpm --filter @midnight-messenger/web build",
    "lint": "pnpm -r lint --if-present",
    "typecheck": "pnpm -r typecheck --if-present"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "unrs-resolver",
      "esbuild",
      "@tailwindcss/oxide"
    ]
  }
}