{
  "name": "@midnight-messenger/contracts",
  "version": "0.3.0",
  "private": true,
  "description": "Night Messenger Compact contract: private group inboxes, ciphertext commitments, anonymous membership proofs, selective author disclosure",
  "type": "module",
  "scripts": {
    "compile": "compact compile +0.36.1 src/night_messenger.compact src/managed/night_messenger",
    "compile:fast": "compact compile +0.36.1 --skip-zk src/night_messenger.compact src/managed/night_messenger",
    "test": "node ../scripts/compact-bindings.mjs && node --experimental-strip-types --no-warnings --test test/*.test.mjs",
    "prove:local": "node --experimental-strip-types --no-warnings scripts/prove-local.mjs",
    "demo": "node --experimental-strip-types --no-warnings scripts/e2e-demo.mjs",
    "sim": "node --no-warnings sim/server.mjs",
    "stats": "node --no-warnings scripts/stats.mjs",
    "preprod": "node --experimental-strip-types --no-warnings preprod/night-messenger-preprod.mjs",
    "preprod:wallet": "node --experimental-strip-types --no-warnings preprod/generate-preprod-wallet.mjs"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.21.0",
    "@midnightntwrk/onchain-runtime-v4": "4.0.2"
  },
  "devDependencies": {
    "@midnight-ntwrk/compact-js": "3.0.2",
    "@midnight-ntwrk/midnight-js-contracts": "5.0.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "5.0.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "5.0.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "5.0.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "5.0.1",
    "@midnight-ntwrk/midnight-js-protocol": "5.0.1",
    "@midnight-ntwrk/midnight-js-types": "5.0.1",
    "@midnight-ntwrk/midnight-js-utils": "5.0.1",
    "@midnightntwrk/wallet-sdk": "2.0.1",
    "rxjs": "^7.8.1",
    "ws": "^8.18.0",
    "@midnight-ntwrk/testkit-js": "5.0.1",
    "@midnightntwrk/ledger-v9": "1.0.2"
  },
  "license": "Apache-2.0"
}
